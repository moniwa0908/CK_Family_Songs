name: Update C&K News

on:
  schedule:
    - cron: "17 */6 * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-news:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Fetch latest C&K NEWS
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');

            const source = 'https://c-and-k.info/contents/news';
            const response = await fetch(source, {
              headers: {
                'User-Agent': 'CK-Family-Songs-News-Updater/1.0 (+GitHub Actions)'
              }
            });
            if (!response.ok) {
              throw new Error(`C&K NEWS fetch failed: ${response.status}`);
            }

            const html = await response.text();

            const decodeEntities = (text) => text
              .replace(/&amp;/g, '&')
              .replace(/&quot;/g, '"')
              .replace(/&#39;/g, "'")
              .replace(/&lt;/g, '<')
              .replace(/&gt;/g, '>')
              .replace(/&nbsp;/g, ' ')
              .replace(/&#x([0-9a-f]+);/gi, (_, hex) => String.fromCodePoint(parseInt(hex, 16)))
              .replace(/&#([0-9]+);/g, (_, dec) => String.fromCodePoint(parseInt(dec, 10)));

            const stripTags = (value) => decodeEntities(
              value
                .replace(/<script[\s\S]*?<\/script>/gi, ' ')
                .replace(/<style[\s\S]*?<\/style>/gi, ' ')
                .replace(/<[^>]+>/g, ' ')
            ).replace(/\s+/g, ' ').trim();

            const items = [];
            const seen = new Set();
            const anchorPattern = /<a\b[^>]*href=["']([^"']*\/contents\/\d+)(?:["'][^>]*)>([\s\S]*?)<\/a>/gi;

            let match;
            while ((match = anchorPattern.exec(html)) !== null) {
              const url = new URL(match[1], source).href;
              if (seen.has(url)) continue;

              const text = stripTags(match[2]);
              const dateMatch = text.match(/\b(20\d{2}[.\-/]\d{2}[.\-/]\d{2})\b/);
              if (!dateMatch) continue;

              let title = text.slice(0, dateMatch.index).trim();
              title = title.replace(/\s+(NEW|NEWS|GOODS)\s*$/i, '').trim();
              if (!title || title.length < 2) continue;

              seen.add(url);
              items.push({
                date: dateMatch[1].replace(/-/g, '.').replace(/\//g, '.'),
                title,
                url
              });

              if (items.length >= 3) break;
            }

            if (items.length < 3) {
              throw new Error(`Could not parse 3 news items. Parsed: ${items.length}`);
            }

            const output = {
              source,
              updatedAt: new Date().toISOString(),
              items
            };

            fs.writeFileSync('news.json', JSON.stringify(output, null, 2) + '\n', 'utf8');
            console.log(output);

      - name: Commit updated news
        run: |
          if git diff --quiet -- news.json; then
            echo "No NEWS changes."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add news.json
          git commit -m "Update C&K NEWS"
          git push
